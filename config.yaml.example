# alwaysblock configuration
# Block distracting websites and unblock them with intentional delays

# How concurrent unblocks work:
# If you unblock slack (1 min wait), then try to unblock youtube while
# slack is still pending, youtube gets: 10 min (base) + 5 min (penalty) = 15 min wait
# Each additional pending unblock adds another 5 min penalty.
# This discourages opening multiple sites at once.

default_profile: unblock

# Domains to block
domains:
  # Social Media
  reddit.com:
    tags: [social]
  twitter.com:
    tags: [social, news]
  x.com:
    tags: [social, news]
  facebook.com:
    tags: [social]
  instagram.com:
    tags: [social]
  linkedin.com:
    tags: [social, work]
  tiktok.com:
    tags: [social]
  
  # Entertainment
  youtube.com:
    tags: [entertainment, streaming]
  netflix.com:
    tags: [entertainment, streaming]
  hulu.com:
    tags: [entertainment, streaming]
  twitch.tv:
    tags: [entertainment, streaming]
  spotify.com:
    tags: [entertainment, music]
  
  # News
  nytimes.com:
    tags: [news]
  wsj.com:
    tags: [news]
  bbc.com:
    tags: [news]
  cnn.com:
    tags: [news]
  theguardian.com:
    tags: [news]
  reuters.com:
    tags: [news]
  bloomberg.com:
    tags: [news, finance]
  
  # Shopping
  amazon.com:
    tags: [shopping]
  ebay.com:
    tags: [shopping]
  
  # Domain groups (multiple related domains)
  google:
    domains:
      - google.com
      - gmail.com
      - mail.google.com
      - calendar.google.com
      - docs.google.com
      - drive.google.com
      - meet.google.com
      - googleusercontent.com
      - gstatic.com
      - googleapis.com
    tags: [work, productivity]
  
  slack:
    domains:
      - slack.com
      - app.slack.com
      - slack-edge.com
      - slack-imgs.com
    tags: [work, communication]
  
  reddit:
    domains:
      - reddit.com
      - redd.it
      - redditstatic.com
      - redditmedia.com
    tags: [social]
  
  youtube:
    domains:
      - youtube.com
      - googlevideo.com
      - ytimg.com
      - ggpht.com
      - youtube-nocookie.com
    tags: [entertainment, streaming]
  
  twitter:
    domains:
      - twitter.com
      - x.com
      - t.co
      - twimg.com
    tags: [social, news]
  
  facebook:
    domains:
      - facebook.com
      - fbcdn.net
      - facebook.net
      - fbsbx.com
      - fb.com
      - messenger.com
    tags: [social]
  
  instagram:
    domains:
      - instagram.com
      - cdninstagram.com
      - fbcdn.net
    tags: [social]
  
# Profiles (different unblocking strategies)
profiles:
  # Default profile with wait times
  unblock:
    description: "Standard unblock"
    wait:
      base: 5              # 5 minute wait
      concurrent_penalty: 5 # +5 min per concurrent unblock
    duration: 30           # Stay unblocked for 30 minutes
    tag_rules:
      - tags: [work, communication]
        wait_override: 1   # 1 min wait for Slack, Gmail
      - tags: [streaming]
        wait_override: 10  # 10 min wait for Netflix, YouTube
  
  # Quick access
  quick:
    description: "Quick 5 minute access"
    wait: 1
    duration: 5
    cooldown: 30  # Can only use once per 30 min
  
  # Emergency bypass
  bypass:
    description: "Emergency bypass"
    wait: 0
    duration: 5
    cooldown: 60  # Once per hour
  
  # Work mode - only work sites
  work:
    description: "Work sites only"
    tags: [work, productivity, development]
    wait: 0
    duration: 120  # 2 hours
    cooldown: 30
  
  # Email/Slack only
  email:
    description: "Email and Slack only"
    only: [google, slack]
    wait: 0
    duration: 15
