# AlwaysBlock Configuration (Simple Example)

default_profile: unblock

# Which enforcement backend(s) this machine uses. This is YOUR choice per
# machine — there is no repo-wide default. If you omit this block entirely,
# AlwaysBlock behaves exactly as it always has: proxy on, extension off.
#
#   proxy:     system-wide HTTP/HTTPS proxy. Covers every app and browser,
#              including Safari and Chrome Incognito. Needs sudo (it manages the
#              macOS system proxy). This is the historical backend.
#   extension: the Chrome extension (load it from the alwaysblock-chrome/ folder).
#              Covers Chrome tabs only — including tabs whose traffic a separate
#              proxy extension (e.g. SwitchyOmega) reroutes around the system
#              proxy. Needs no sudo; runs as a per-user LaunchAgent.
#
# Run both for full coverage: the extension blocks inside Chrome even when a
# proxy extension would bypass the system proxy, and the system proxy covers
# Safari, Incognito, and everything non-Chrome.
#
# backends:
#   proxy: true
#   extension: true

# OPT-IN: quit native apps while their sites are blocked. Off by default.
# Apps like Slack hide a blocked connection — a message looks sent but silently
# isn't. With this, the app is quit whenever its sites are blocked, so "blocked"
# is unmistakable; unblock the site and you can reopen the app normally. The
# proxy still does the actual blocking — this just closes the app. Runs as a
# per-user LaunchAgent (no sudo). `app` is the exact process name (`pgrep -x`),
# `when_blocked` lists config domain/group name(s).
#
# kill_apps:
#   - app: Slack
#     when_blocked: [slack.com]

# Globally excluded domains (always allowed, even if parent domain is blocked)
excluded_domains:
  - accounts.google.com   # Allow Google accounts (for GSuite login)
  - myaccount.google.com  # Allow Google account management
  - accounts.youtube.com  # Allow YouTube accounts (for GSuite login)

domains:
  facebook.com:
  instagram.com:
  twitter.com:
  x.com:
  reddit.com:
  youtube.com:
  google.com:

profiles:
  # Standard: 5 min wait, 30 min access
  unblock:
    wait: 5
    duration: 30

  # Quick check: 30 sec wait, 1 min access
  quick:
    wait: 0.5
    duration: 1

  # Emergency bypass: instant, 5 min access, 1 hour cooldown
  bypass:
    wait: 0
    duration: 5
    cooldown: 60
