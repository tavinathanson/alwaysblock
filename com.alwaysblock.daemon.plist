<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- LaunchDaemon for AlwaysBlock -->
    <!-- Runs as root, starts on boot, keeps proxy and system proxy enabled -->

    <key>Label</key>
    <string>com.alwaysblock.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/alwaysblock-daemon</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/alwaysblock_daemon.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/alwaysblock_daemon_error.log</string>

    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
